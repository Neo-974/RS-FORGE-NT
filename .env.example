# ============================================================
# RS-Builder — Variables d'environnement requises
# Copiez ce fichier en .env.local et remplissez les valeurs
# NE JAMAIS committer .env.local dans git
# ============================================================

# --- Supabase ---
# Trouvez ces valeurs dans : Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clé service role (accès complet, uniquement côté serveur — jamais exposée)
# Trouvez-la dans : Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Anthropic Claude ---
# Créez une clé sur : console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...
